<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AcessoFast — LaunchAgent do CLIENTE (parte da sessao grafica).

  Copia fiel do modelo do RustDesk (privileges_scripts/agent.plist), com os nomes
  substituidos.

  E ESTE que recebe a sessao. Confirmado em campo (01/09/2026): o processo que segura
  o socket e escreve as linhas de conexao no log e o que roda com --server, na sessao
  do usuario — e por isso o log sai em /Users/<usuario>/Library/Logs, nao no home do
  root. plat_darwin.go reinicia este servico no dominio gui/<uid>, e nao em system/.

  LimitLoadToSessionType com LoginWindow e o que permite atender antes de alguem
  logar. Sem isso nao ha acesso desatendido de verdade.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carriez.AcessoFast_server</string>

    <key>AssociatedBundleIdentifiers</key>
    <string>br.com.acessofast.client</string>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>LoginWindow</string>
        <string>Aqua</string>
    </array>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>AfterInitialDemand</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>1</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/AcessoFast.app/Contents/MacOS/AcessoFast</string>
        <string>--server</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Applications/AcessoFast.app/Contents/MacOS/</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
